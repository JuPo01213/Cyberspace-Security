.echo LOCAL_CONFIG_FOLLOWUP_BEGIN
.echo IMAGE_IDENTITY
lm m EPT*
db 0x140000000 L2
dd 0x14000003c L1
.echo SAVE_INPUT_COPY
u 0x14079a790 L0n90
.echo SAVE_CRYPTO_LOCATOR
u 0x14079acc0 L0n35
u 0x14079b000 L0n30
u 0x1407a6b80 L0n45
.echo CRYPTO_PARAMETERS
u 0x1407a3b64 L0n20
u 0x1407a3db1 L0n20
u 0x1407a3fd5 L0n35
u 0x1407a41fc L0n14
.echo WRAPPER_IMPORT_KEYS
u 0x141713a41 L0n18
u 0x141616231 L0n18
u 0x1418a78a8 L0n18
.echo CONFIG_LENGTH_CHECK
u 0x1407a443c L0n4
.echo CONFIG_COPY_BLOCK
u 0x1407a4608 L0n50
.echo COPY_LENGTH_ARITHMETIC
? 6*0x80+0x70+8+2
.echo CONFIG_FIELD_OFFSETS
? 0x141154ae7-0x141154980
? 0x141154ce5-0x141154980
? 0x141154ce9-0x141154980
? 0x141154ced-0x141154980
? 0x141154cf1-0x141154980
? 0x141154cf6-0x141154980
.echo LOCAL_CONFIG_FOLLOWUP_END
q
