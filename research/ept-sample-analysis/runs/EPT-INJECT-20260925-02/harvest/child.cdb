.echo [RECON_CHILD_ATTACHED]
.symfix
.reload
sxd ibp
sxd epr
sxe av
bu 14235f67b ".echo [RECON_CHILD_ENTRY]; k; g"
bu kernel32!DeviceIoControl ".echo [RECON_DIOC]; r rcx; r rdx; r r8; r r9; dq @rsp L8; k; $$><late.cdb; .echo [RECON_DIOC_AFTER_LATE]; g"
sxe -c ".echo [RECON_CHILD_AV]; .lastevent; r; k; g" av
.echo [RECON_CHILD_BPS_ARMED]
g
