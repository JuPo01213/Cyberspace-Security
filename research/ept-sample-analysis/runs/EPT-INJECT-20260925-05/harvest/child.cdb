.echo [RECON4_CHILD_ATTACHED]
$$ Device-open recon: catch ANY \\.\ device path via CreateFileW/A (filtered), and NtDeviceIoControlFile (full params)
$$ CreateFileW: rcx=lpFileName
bp kernel32!CreateFileW ".if (@rcx!=0) { .if (by(@rcx)==0x5c) { .echo [RECON4_CREATEFILEW_C]; r rcx; dU @rcx L16 } .else { g } } .else { g }"
bp kernel32!CreateFileA ".if (@rcx!=0) { .if (by(@rcx)==0x5c) { .echo [RECON4_CREATEFILEA_C]; r rcx; dU @rcx L16 } .else { g } } .else { g }"
$$ NtDeviceIoControlFile: RCX=FileHandle; [rsp+0x28]=IoStatusBlock [rsp+0x30]=IoControlCode [rsp+0x38]=InputBuffer [rsp+0x40]=InputBufferLength [rsp+0x48]=OutputBuffer [rsp+0x50]=OutputBufferLength
bp ntdll!NtDeviceIoControlFile ".echo [RECON4_DIOC_C]; r rcx; r rdx; r r8; r r9; dq @rsp L12; g"
.echo [RECON4_CHILD_BPS_ARMED]
