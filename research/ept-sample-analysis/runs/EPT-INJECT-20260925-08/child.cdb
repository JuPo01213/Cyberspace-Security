.echo [AUTHG_CHILD_ATTACHED]
$$ child: observe only (device I/O + device-path opens), no sample 0xCC
bp kernel32!CreateFileW ".if (@rcx!=0) { .if (by(@rcx)==0x5c) { .echo [AUTHG_CREATEFILEW_C]; r rcx; dU @rcx L16 } .else { g } } .else { g }"
bp ntdll!NtDeviceIoControlFile ".echo [AUTHG_DIOC_C]; r rcx; r rdx; r r8; r r9; dq @rsp L12; k L10; g"
.echo [AUTHG_CHILD_BPS_ARMED]
