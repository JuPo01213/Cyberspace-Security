.echo [WAIT_CHILD_ATTACHED]
$$ WAIT DIAGNOSTIC (child = real payload): what is the sample blocked on?
bp ntdll!NtDelayExecution ".echo [WAIT_C_SLEEP]; r rcx; r rdx; k L12; g"
bp ntdll!NtWaitForSingleObject ".echo [WAIT_C_OBJ]; r rcx; r rdx; r r8; k L12; g"
bp ntdll!NtDelayExecution 12 ".echo [SNAP_C_ALL_THREADS]; ~* k; g"
bp kernel32!CreateFileW ".if (@rcx!=0) { .if (by(@rcx)==0x5c) { .echo [WAIT_C_CREATEFILEW]; r rcx; dU @rcx L16 } .else { g } } .else { g }"
.echo [WAIT_CHILD_BPS_ARMED]
