.echo [SCAN_CHILD_ATTACHED]
$$ child: observe only (device opens + device I/O), no sample 0xCC
bp kernel32!CreateFileW ".if (@rcx!=0) { .if (by(@rcx)==0x5c) { .echo [SCAN_CREATEFILEW_C]; r rcx; dU @rcx L16 } .else { g } } .else { g }"
bp ntdll!NtDeviceIoControlFile ".echo [SCAN_DIOC_C]; r rcx; r rdx; r r8; r r9; dq @rsp L12; k L6; g"
.echo [SCAN_CHILD_BPS_ARMED]
